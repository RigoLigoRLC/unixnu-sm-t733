 	b		Lcheck_cpu_data_entry	// loop
 Lfound_cpu_data_entry:
 
+#if XNU_NATIVE_ARCH_TIMER
+	// The per-CPU record remains reachable at its physical address before MMU setup.
+	ldrh	w4, [x21, CPU_NUMBER_GS]
+	adrp	x6, EXT(armcpu_secondary_entry)@page
+	add		x6, x6, EXT(armcpu_secondary_entry)@pageoff
+	mov		w5, #1
+	str		w5, [x6, x4, lsl #2]
+	dsb		sy
+#endif
+
+
 
 	adrp	x20, EXT(const_boot_args)@page
 	add		x20, x20, EXT(const_boot_args)@pageoff
