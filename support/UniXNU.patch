++static bool
++trace_accept(struct u_trace *trace, uint32_t count, uint32_t type, uint64_t allocation_bytes)
++{
++   tu_darwin_trace_state *state = trace_state((tu_device *)trace->utctx->pctx);
++   pthread_mutex_lock(&state->mutex);
++
++   /* Each begin reserves the enabled end payload and a new timestamp chunk. */
++   if (type == 1) {
++      bool accept = false;
++      if (trace->external_range_depth) {
++         const uint32_t depth = --trace->external_range_depth;
++         accept = depth < 64 && !(trace->external_rejected_ranges & (1ull << depth));
++      }
++      if (accept) {
++         state->reserved_bytes -= TRACE_END_BYTES;
++         trace->external_reserved_bytes -= TRACE_END_BYTES;
++         state->reserved_bytes += allocation_bytes;
++         trace->external_reserved_bytes += allocation_bytes;
++      }
++      pthread_mutex_unlock(&state->mutex);
++      return accept;
++   }
++
++   const uint64_t reserved = allocation_bytes + (type == 0 ? TRACE_END_BYTES : 0);
