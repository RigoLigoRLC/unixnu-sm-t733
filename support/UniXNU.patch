+STATIC
+BOOLEAN
+IsConfirmKey (
+  IN CONST EFI_INPUT_KEY  *Key
+  )
+{
+  return (Key->UnicodeChar == CHAR_CARRIAGE_RETURN) ||
+         (Key->UnicodeChar == CHAR_LINEFEED) ||
+         (Key->UnicodeChar == L' ') ||
+         (Key->ScanCode == SCAN_RIGHT) ||
+         (Key->ScanCode == SCAN_SUSPEND) ||
+         ((Key->ScanCode == SCAN_SAMSUNG_POWER) && (Key->UnicodeChar == 0));
