++struct tu_darwin_trace_state {
++   struct tu_device *device;
++   pthread_t worker;
++   pthread_mutex_t mutex;
++   pthread_cond_t changed;
++   bool stop;
++   uint32_t active_generation;
++   NativeAdrenoTraceProducer producer;
++   NativeAdrenoTraceEvent events[TRACE_LOCAL_EVENTS];
++   uint32_t head;
++   uint32_t count;
++   uint32_t dropped;
++   uint32_t budget_dropped;
++   uint32_t queue_dropped;
++   uint32_t append_dropped;
++   uint32_t unsubmitted_commands;
++   uint32_t unexecuted_gmem_points;
++   uint64_t reserved_bytes;
++   uint64_t reserved_bytes_peak;
++   uint32_t pending_commands;
++   uint32_t pending_submissions;
++   bool end_records_written;
++   uint64_t timestamp_dwords;
++   uint64_t copy_dwords;
++   uint64_t wait_dwords;
++   uint64_t stage_commands[12];
++   mach_timebase_info_data_t timebase;
